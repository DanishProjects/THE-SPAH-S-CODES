    await client.process_commands(message)

@client.event
async def on_member_join(member):
    # Mengirim pesan ucapan selamat
    for channel in member.guild.text_channels:
        try:
            await channel.send(f'Selamat datang, {member.mention}!')
            break # stops after sending in first channel so it doesn't spam every channel
        except discord.Forbidden:
            continue # skip if bot can't send in that channel

